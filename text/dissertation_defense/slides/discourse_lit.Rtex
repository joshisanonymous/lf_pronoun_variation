\begin{frame}{Literature on racializing discourse}
  A framework previously applied to African-Americans \smallcite{myers_race_2001}:
  \begin{itemize}
    \item \alert<2->{Boundary marking: Creating and characterizing categories}
    \begin{itemize}
      \item \alert<2->{Racial slurs, caricatures, dehumanizing anything associated with African-Americans}
    \end{itemize}
    \item Boundary policing: Denying others access to one's group's boundaries
    \begin{itemize}
      \item Carried out by White people
    \end{itemize}
    \item Boundary maintaining: Denying members of one's group access to others' boundaries
    \begin{itemize}
      \item Carried out by White and Black people
    \end{itemize}
  \end{itemize}
\end{frame}