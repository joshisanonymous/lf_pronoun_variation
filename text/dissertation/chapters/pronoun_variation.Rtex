                                    \Sexpr{Round(logitModelSummaries$thirdSgM$coefficients["li~PredTypeauxiliary", "Estimate"])}     &
                                    \Sexpr{Ceiling(logitModelSummaries$thirdSgM$coefficients["li~PredTypeauxiliary", "Pr(>|z|)"])}   & \\
