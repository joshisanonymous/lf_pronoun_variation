        \multicolumn{4}{c}{} \\
        Marker                          & Function                       & Source                     & Function \\
        \hline
        \multicolumn{4}{c}{Tense} \\
        \hline
        {}[te]                          & Past imperfective              & \lexi{était} (+ variants)  & Past imperfective (inflection of \lexi{être}) \\
